# Copy this file to .env.local and fill in your own Firebase project's
# values: Firebase Console → Project Settings (gear icon) → General tab →
# scroll to "Your apps" → Web app → SDK setup and configuration → Config.
#
# .env.local is gitignored — these values are safe to keep here locally,
# but never commit real secrets to a public repo out of habit. (Firebase's
# client config specifically is NOT a secret — it's meant to ship inside
# your deployed app — but .env.local is still the right place for it so
# each environment/developer can point at a different Firebase project.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
